# ---------------------------------------------------------------- élesítés
# Másold .env.local néven (lokálisan), Vercelen pedig Settings → Environment
# Variables alatt vidd fel ugyanezeket.

# A végleges domain. Ebből származik a kanonikus URL, a sitemap, az Open Graph
# metaadat és az adatvédelmi tájékoztató szövege. Záró perjel nélkül.
NEXT_PUBLIC_SITE_URL=https://sajatdomain.hu

# A weboldalon megjelenő címek. Ha üresen hagyod, a domainből képződnek.
NEXT_PUBLIC_CONTACT_EMAIL=kapcsolat@sajatdomain.hu
NEXT_PUBLIC_PRIVACY_EMAIL=adatvedelem@sajatdomain.hu


# ------------------------------------------------- a kapcsolatfelvételi űrlap
# Amíg egyik útvonal sincs beállítva, a /api/kapcsolat 503 `no_sink` választ ad,
# és az űrlap a közvetlen e-mail-címet mutatja. Ez szándékos: egy űrlap, amely
# látszólag elküldi az adatot, de sehova nem juttatja el, rosszabb, mintha nem
# lenne űrlap.

# 1. útvonal — e-mail (Resend). Ez az egyszerűbb, ha nincs CRM-ed.
#    A kulcs: resend.com → API Keys.
RESEND_API_KEY=
#    Ide érkezik a megkeresés (bármilyen postafiók lehet).
EZEKIEL_LEAD_TO=
#    Feladó. Csak akkor használhatsz saját domaint, ha a Resendben hitelesítetted
#    (DNS-rekordok). Amíg nincs, hagyd üresen — az onboarding@resend.dev címről
#    megy, ami csak a Resend-fiókod saját címére kézbesíthető.
EZEKIEL_LEAD_FROM=

# 2. útvonal — webhook, ha van CRM-ed vagy automatizálásod (Zapier, Make, n8n).
#    Ha mindkettő be van állítva, az e-mail az elsődleges.
EZEKIEL_LEAD_WEBHOOK=


# ------------------------------------------------- csak a statikus előnézethez
# A GitHub Pages workflow állítja be, kézzel nem kell velük foglalkozni.
# EZEKIEL_STATIC_EXPORT=1
# EZEKIEL_BASE_PATH=/Ezekiel-web
# NEXT_PUBLIC_STATIC_DEMO=1
# EZEKIEL_DIST_DIR=out
